# =============================================================================
#  PROJECT RESILIENCE-ALPHA — AlphaPay — modèle de configuration
# =============================================================================
#  Copier en `.env` puis renseigner, ou laisser `scripts/seed-secrets.sh`
#  générer automatiquement des valeurs aléatoires fortes.
#
#      cp .env.example .env
#      bash scripts/seed-secrets.sh
#
#  Le fichier `.env` est ignoré par Git : aucun secret ne doit être versionné.
#  En production réelle, ces valeurs proviendraient d'un coffre (Vault, SOPS) et
#  non d'un fichier en clair ; c'est l'écart assumé et documenté pour un
#  environnement de démonstration sur poste isolé.
# =============================================================================

# --- Identité du groupe -------------------------------------------------------
# Utilisé dans les noms de livrables : Workshop2026-M2-G<n>
GROUP_NUMBER=1
TZ=Europe/Paris
LOG_LEVEL=INFO

# --- Base de données ----------------------------------------------------------
POSTGRES_DB=alphapay
POSTGRES_PASSWORD=

# Un mot de passe par service : la compromission de l'un ne donne pas accès aux
# autres schémas. C'est la traduction en base du principe de moindre privilège.
SVC_AUTH_PASSWORD=
SVC_PAYMENT_PASSWORD=
SVC_LEDGER_PASSWORD=
SVC_DETECTOR_PASSWORD=
SVC_REMEDIATION_PASSWORD=
SVC_RAG_PASSWORD=
SVC_READONLY_PASSWORD=
MONITORING_PASSWORD=

# --- Secrets applicatifs ------------------------------------------------------
# Signature des notifications entre composants (détecteur, Falco, Alertmanager
# vers le moteur de remédiation).
HMAC_SECRET=
# Jeton d'administration : protège les points d'entrée de remédiation et
# l'insertion dans le corpus documentaire.
ADMIN_API_TOKEN=
# Mot de passe du compte de sonde utilisé par la suite de vérification.
PROBE_PASSWORD=

# --- Coffre de secrets --------------------------------------------------------
# Mode développement : le coffre est en mémoire et scellé par ce jeton racine.
# En production, il serait initialisé et descellé manuellement.
VAULT_DEV_ROOT_TOKEN=

# --- Supervision --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Ports publiés sur le poste hôte -------------------------------------------
# La bordure expose HTTP et HTTPS. Les autres ports ne servent qu'au diagnostic
# par les coachs et le jury.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Modèles locaux (assistant documentaire) ----------------------------------
# Modèles compatibles avec un poste à 16 Go de mémoire vive et sans carte
# graphique. `ASSISTANT_MODE=off` désactive complètement l'assistant, ce qui
# permet de déployer la pile sur un poste de délestage sans capacité
# d'inférence.
ASSISTANT_LLM_MODEL=llama3.2:3b
ASSISTANT_EMBED_MODEL=nomic-embed-text
ASSISTANT_MODE=full
OLLAMA_MODELS_PULL=llama3.2:3b,nomic-embed-text

# --- Objectifs de service -----------------------------------------------------
# Cibles affichées dans la salle d'opérations ; elles servent aussi de repère
# d'évaluation lors de la démonstration.
MTTD_TARGET_SECONDS=60
MTTR_TARGET_SECONDS=180

# --- Environnement de test isolé ----------------------------------------------
# À ne renseigner QUE si le démon Docker est distant et ne partage pas le
# système de fichiers du poste hôte (cas de l'environnement d'intégration
# continue). Laisser vide sur le poste hôte du workshop.
# REMEDIATION_DOCKER_HOST=tcp://dind:23757
