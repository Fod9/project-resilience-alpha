# Secrets et configuration locale : jamais versionnés.
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep

# Artefacts d'exécution
*.log
logs/
deliverables/*.mp4
deliverables/*.pptx
deliverables/*.pdf
!deliverables/.gitkeep
# Artefacts de rendu du dossier (schemas Mermaid, HTML assemble, apercus)
deliverables/dossier/build/
deliverables/dossier/dossier.html
deliverables/dossier/dossier-inline.html

# Modèles entraînés. Le fichier `.joblib` est versionné, malgré sa taille : sans
# lui, un clone neuf construit une image de détecteur sans aucun modèle, et le
# service s'entraîne alors au démarrage sur du trafic simulé, ce qui produit un
# seuil bien plus strict que la calibration sur trafic réel. Le résultat était un
# détecteur qui signale la plateforme au repos, sans que rien ne dise d'où venait
# le seuil. La régénération reste possible : `python -m ml.train` pour un modèle
# sur trafic simulé, `python -m ml.recalibrer` pour recalibrer le seuil.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
frontend/public/models/
frontend/.vite/

# Outils
.DS_Store
*.swp
.idea/
.vscode/
