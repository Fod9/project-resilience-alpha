# =============================================================================
#  AlphaPay : configuration de site de la bordure
# =============================================================================
#  Remplace la configuration mono-amont fournie par l'image. Trois rôles :
#
#   1. WAF : ModSecurity v3 + OWASP CRS, activé au niveau `http` pour couvrir
#      toutes les requêtes, y compris celles rejetées avant tout amont.
#   2. Aiguillage : sept amonts internes (frontend, quatre services métier,
#      détecteur, assistant). La résolution DNS est dynamique (`proxy_pass` à
#      variable) afin qu'une reprise de conteneur, qui change son adresse IP,
#      soit prise en compte en quelques secondes.
#   3. Observabilité : un journal d'accès JSON dont le schéma est le contrat
#      d'entrée du service de télémétrie.
#
#  Le résolveur DNS n'est pas redéclaré ici : la configuration racine de
#  l'image en définit un au niveau `http` (script 91-update-resolver.sh).
# =============================================================================

server_tokens off;
more_set_headers 'Server: alphapay-edge';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -----------------------------------------------------------------------------
#  Liste de blocage : alimentée par le moteur de remédiation dans le volume
#  partagé. L'inclusion par motif tolère un répertoire vide : aucun fichier
#  factice n'est nécessaire au premier démarrage.
# -----------------------------------------------------------------------------
map $remote_addr $alphapay_blocked {
    default 0;
    include /etc/nginx/dynamic/blocklist*.map;
}

# -----------------------------------------------------------------------------
#  Classe de route, utilisée pour étiqueter chaque requête dans les métriques.
#  `$request_uri` est utilisé et non `$uri` : l'étiquette doit refléter le
#  chemin demandé par le client, pas le chemin réécrit pour l'amont.
# -----------------------------------------------------------------------------
map $request_uri $alphapay_route {
    default              "web";
    "~^/api/auth"        "auth";
    "~^/api/payments"    "payment";
    "~^/api/ledger"      "ledger";
    "~^/api/supervision" "ops";
    "~^/api/ops"         "ops";
    "~^/api/detector"    "detector";
    "~^/api/assistant"   "assistant";
}

# Un 403 sans amont sollicité est un blocage de bordure ; un 403 accompagné
# d'une réponse d'amont est un refus d'autorisation applicatif. La distinction
# est explicite, ce qui évite de confondre les deux dans les métriques.
map $upstream_status $alphapay_upstream_seen {
    default $upstream_status;
    ""      "-";
}
map "$status:$alphapay_upstream_seen" $alphapay_waf_blocked {
    default 0;
    "403:-" 1;
}

# -----------------------------------------------------------------------------
#  Limitation de débit : première ligne de défense, avant le moteur de
#  remédiation. Volontairement large pour ne pas gêner la démonstration.
# -----------------------------------------------------------------------------
limit_req_zone  $binary_remote_addr zone=alphapay_auth:10m rate=15r/s;
limit_req_zone  $binary_remote_addr zone=alphapay_api:16m  rate=60r/s;
#
# Zone dediee aux points d'observation du tableau de bord.
#
# Sans elle, l'ops room se fait couper par sa propre protection : la
# limitation s'applique par adresse source, et depuis l'exterieur toutes les
# requetes arrivent par la meme publication de port. Une attaque lancee
# depuis la machine hote consomme donc le quota du navigateur qui regarde le
# tableau de bord, et l'operateur perd sa vue au moment precis ou il en a le
# plus besoin. Le WAF continue de proteger ces routes ; la limitation y est
# seulement desserree.
limit_req_zone  $binary_remote_addr zone=alphapay_obs:10m rate=300r/s;
limit_conn_zone $binary_remote_addr zone=alphapay_conn:10m;

# -----------------------------------------------------------------------------
#  Journal d'accès JSON : contrat d'entrée du service de télémétrie
# -----------------------------------------------------------------------------
log_format alphapay_json escape=json
    '{'
      '"ts":"$time_iso8601",'
      '"level":"INFO",'
      '"service":"edge",'
      '"logger":"edge.access",'
      '"event":"http.request",'
      '"trace_id":"$request_id",'
      '"source_ip":"$remote_addr",'
      '"fields":{'
        '"method":"$request_method",'
        '"path":"$uri",'
        '"route":"$alphapay_route",'
        '"status":$status,'
        '"duration_s":$request_time,'
        '"bytes_in":$request_length,'
        '"bytes_out":$bytes_sent,'
        '"user_agent":"$http_user_agent",'
        '"waf_blocked":$alphapay_waf_blocked,'
        '"redteam_marker":"$http_x_alphapay_redteam"'
      '}'
    '}';

# Le volume partagé alimente Promtail (Loki) et le service de télémétrie.
# La sortie standard reste alimentée pour `docker logs`.
access_log /var/log/alphapay/edge.jsonl alphapay_json buffer=8k flush=1s;
access_log /dev/stdout alphapay_json;
error_log  /var/log/alphapay/edge-error.log warn;

# -----------------------------------------------------------------------------
#  WAF : activé globalement
# -----------------------------------------------------------------------------
modsecurity on;
modsecurity_rules_file /etc/modsecurity.d/setup.conf;

# =============================================================================
#  Serveur HTTP (port interne 8080)
# =============================================================================
server {
    listen ${PORT} default_server;
    server_name _;

    client_body_timeout 15s;
    client_header_timeout 15s;
    client_max_body_size 256k;
    keepalive_timeout 30s;

    if ($alphapay_blocked) {
        return 403;
    }

    limit_conn alphapay_conn 60;

    include includes/alphapay_locations.conf;
}

# =============================================================================
#  Serveur HTTPS (port interne 8443)
# =============================================================================
server {
    listen ${SSL_PORT} ssl;
    server_name _;

    ssl_certificate     ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache   shared:AlphaPayTLS:5m;
    ssl_session_tickets off;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    client_body_timeout 15s;
    client_header_timeout 15s;
    client_max_body_size 256k;
    keepalive_timeout 30s;

    if ($alphapay_blocked) {
        return 403;
    }

    limit_conn alphapay_conn 60;

    include includes/alphapay_locations.conf;
}
