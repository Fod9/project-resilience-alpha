# En-têtes de mandatement + contrôle de liste de blocage, partagés par tous les
# emplacements qui desservent la plateforme.
#
# Le contrôle vivait auparavant au niveau du serveur : une adresse confinée se
# voyait alors refuser *toutes* les requêtes, y compris celle qui demande sa
# libération. Le confinement n'avait plus d'issue et il fallait intervenir dans
# le conteneur de bordure pour en sortir. Il est désormais évalué par
# emplacement ; la route de libération n'inclut que les en-têtes.

if ($alphapay_blocked) {
    return 403;
}

include includes/alphapay_proxy_entetes.conf;
