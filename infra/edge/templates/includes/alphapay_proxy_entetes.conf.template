# En-têtes de mandatement communs à tous les amonts.
# `X-Request-ID` propage l'identifiant de trace généré par la bordure : il se
# retrouve dans le journal d'accès, dans les journaux applicatifs et dans les
# événements d'incident, ce qui rend une même requête suivable de bout en bout.
#
# Ce fichier ne contient que le mandatement, sans contrôle de liste de blocage :
# la route qui permet à une adresse confinée de demander sa libération doit
# pouvoir l'inclure seule, sinon le blocage n'a pas d'issue.

proxy_http_version 1.1;

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;
proxy_set_header X-Request-ID      $request_id;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;
proxy_set_header Proxy             "";

proxy_buffering        off;
proxy_connect_timeout  5s;
proxy_send_timeout     30s;
proxy_redirect         off;

# `proxy_read_timeout` n'est pas fixé ici : chaque emplacement le règle selon
# le temps de réponse attendu de son amont (l'assistant documentaire est
# nettement plus lent qu'une API métier).

# Un amont indisponible doit échouer vite et visiblement : c'est le signal que
# la sonde de disponibilité de la remédiation interprète.
proxy_next_upstream off;
