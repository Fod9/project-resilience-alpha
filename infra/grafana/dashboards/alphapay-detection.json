{
  "uid": "alphapay-detection",
  "title": "AlphaPay : Detection d'anomalies",
  "description": "Score du modele non supervise, seuil calibre sur le trafic nominal, et variables contributives.",
  "tags": [
    "alphapay",
    "intelligence"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Score d'anomalie et seuil",
      "description": "Le seuil est calibre sur le 99,8e centile du trafic nominal simule.",
      "datasource": {
        "type": "prometheus",
        "uid": "alphapay-prometheus"
      },
      "targets": [
        {
          "expr": "max(alphapay_anomaly_score)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "score"
        },
        {
          "expr": "max(alphapay_anomaly_threshold)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "seuil"
        },
        {
          "expr": "max(alphapay_anomaly_score_max)",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "maximum glissant"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Anomalie en cours",
      "description": "1 lorsque le modele signale un comportement hors norme.",
      "datasource": {
        "type": "prometheus",
        "uid": "alphapay-prometheus"
      },
      "targets": [
        {
          "expr": "max(alphapay_anomaly_anomalous)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Variables observees",
      "description": "Les 18 variables agregees sur une fenetre glissante de 60 secondes.",
      "datasource": {
        "type": "prometheus",
        "uid": "alphapay-prometheus"
      },
      "targets": [
        {
          "expr": "alphapay_feature_value",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "{{feature}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Volume de requetes",
      "description": "Volumetrie observee a la bordure.",
      "datasource": {
        "type": "prometheus",
        "uid": "alphapay-prometheus"
      },
      "targets": [
        {
          "expr": "max(alphapay_feature_value{feature=\"requests_per_second\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "requetes/s"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Signaux d'attaque applicative",
      "description": "Proportion de requetes portant une charge d'injection ou de XSS.",
      "datasource": {
        "type": "prometheus",
        "uid": "alphapay-prometheus"
      },
      "targets": [
        {
          "expr": "max(alphapay_feature_value{feature=\"injection_token_ratio\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "injection"
        },
        {
          "expr": "max(alphapay_feature_value{feature=\"xss_token_ratio\"})",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "xss"
        },
        {
          "expr": "max(alphapay_feature_value{feature=\"waf_block_ratio\"})",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "blocages WAF"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 6,
      "title": "Comportement des identites",
      "description": "Diversite des identites et tentatives par identite.",
      "datasource": {
        "type": "prometheus",
        "uid": "alphapay-prometheus"
      },
      "targets": [
        {
          "expr": "max(alphapay_feature_value{feature=\"unique_identities\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "identites distinctes"
        },
        {
          "expr": "max(alphapay_feature_value{feature=\"auth_attempts_per_identity\"})",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "tentatives/identite"
        },
        {
          "expr": "max(alphapay_feature_value{feature=\"auth_failure_ratio\"})",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "alphapay-prometheus"
          },
          "legendFormat": "taux d'echec"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        }
      }
    }
  ],
  "version": 1,
  "graphTooltip": 1
}